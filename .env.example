# ============================================================
# CrossBorder-Support-Agent 环境变量示例
# 使用方法：cp .env.example .env  然后按需填入真实值
# 生产环境请务必修改 SECRET_KEY / ADMIN_PASSWORD 等敏感项
# ============================================================

# --- 1. 数据库（asyncpg 异步驱动，对应 docker-compose.yml 中的 postgres）---
DATABASE_URL=postgresql+asyncpg://app:app123@localhost:5432/crossborder

# --- 2. Chroma 向量数据库（对应 docker-compose.yml 中的 chroma）---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- 3. 大语言模型（OpenAI 兼容协议，base_url 可指向自建网关）---
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- 4. 安全：JWT 签名密钥与管理员账号（生产环境必须修改！）---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
